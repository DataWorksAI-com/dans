# Copy to .env and adjust as needed. Every value below is optional —
# DANS runs with sane defaults out of the box. See README.md for details.

# ── DANS identity ──────────────────────────────────────────────────────────────
# URN TLD + namespace this instance issues (appear in registered agent URNs:
# urn:{TLD}:{NAMESPACE}:{label})
AGENTNS_TLD=agentns.local
AGENTNS_NAMESPACE=public

# ── Persistence ────────────────────────────────────────────────────────────────
# MongoDB connection string. If unset, DANS runs in-memory (resets on restart).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB=agentns

# ── Firewall / proxy ───────────────────────────────────────────────────────────
# When set, /resolve returns proxy URLs (/proxy/{label}) so every agent call
# flows through the built-in firewall. Set to this instance's public base URL.
A2A_PROXY_ENDPOINTS=http://localhost:8200
# "dans" → /proxy/{label} (self-hosting). "agentgateway" → /a2a/{ns}/{label}.
AGENTNS_PROXY_MODE=dans

# ── Runtime ────────────────────────────────────────────────────────────────────
# Keep workers at 1 — firewall rules + registry live in memory per worker.
AGENTNS_WORKERS=1
AGENTNS_HEALTH_INTERVAL=30

# ── Auth ───────────────────────────────────────────────────────────────────────
# "off" = open (default). "on" = require X-API-Key on writes (needs MONGODB_URI).
DANS_AUTH=off

# ── Optional: fallback + federation ──────────────────────────────────────────────
# Resolve agents from a separate capability registry when not found locally:
# ANS_FALLBACK_URL=http://your-registry:6900
# Connect peer DANS instances at startup (JSON or CSV tld=url,...):
# FEDERATION_REGISTRIES={"acme.io":"http://acme-dans:8200"}

# ── Client SDK (requester_lib / target_lib) ──────────────────────────────────────
AGENTNS_URL=http://localhost:8200
AGENTNS_API_KEY=
